---
const links = [
  { href: '/download', label: 'Download' },
  { href: '/changelog', label: 'Changelog' },
];
const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 inset-x-0 z-50 h-14 border-b border-white/5 backdrop-blur-xl" style="background: rgba(9,9,11,0.80)">
  <div class="max-w-5xl mx-auto px-6 h-full flex items-center justify-between">
    <a href="/" class="text-white font-semibold tracking-tight text-lg">ORBIS</a>

    <div class="flex items-center gap-6">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class={[
            'text-sm transition-colors',
            currentPath.startsWith(href)
              ? 'text-white'
              : 'text-zinc-400 hover:text-zinc-200',
          ].join(' ')}
        >
          {label}
        </a>
      ))}

      <a
        href="https://github.com/protolabsstudio/ORBIS"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-zinc-400 hover:text-zinc-200 transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.021c0 4.428 2.865 8.184 6.839 9.504.5.092.682-.217.682-.483 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.2 22 16.447 22 12.021 22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
    </div>
  </div>
</nav>

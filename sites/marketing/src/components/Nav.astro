---
const links = [
  { href: '/download', label: 'Download', external: false },
  { href: '/editor', label: 'Editor', external: true },
  { href: '/docs', label: 'Docs', external: true },
  { href: '/changelog', label: 'Changelog', external: false },
  { href: 'https://github.com/protoLabsAI/ORBIS', label: 'GitHub', external: true },
];
const currentPath = Astro.url.pathname;
---

<nav aria-label="Main" class="fixed top-0 inset-x-0 z-50 h-20 sm:h-14 border-b border-white/5 backdrop-blur-xl" style="background: rgba(9,9,11,0.80)">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-full flex flex-col sm:flex-row items-center justify-center sm:justify-between gap-2 sm:gap-4">
    <a href="/" class="text-white font-semibold tracking-tight text-lg">ORBIS</a>

    <div class="flex items-center gap-4 sm:gap-6">
      {links.map(({ href, label, external }) => (
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          class={[
            'text-xs sm:text-sm transition-colors',
            currentPath.startsWith(href) && href !== '/'
              ? 'text-white'
              : 'text-zinc-400 hover:text-zinc-200',
          ].join(' ')}
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</nav>

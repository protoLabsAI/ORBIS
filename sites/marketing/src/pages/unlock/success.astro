---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Same issuer Worker as /unlock. The Stripe success_url lands here with
// ?session_id=…; we poll the Worker's /license endpoint for the minted key.
const issuerUrl = import.meta.env.PUBLIC_LICENSE_ISSUER_URL ?? '';
---

<BaseLayout
  title="Your ORBIS license key"
  description="Your ORBIS customization unlock — your license key."
>
  <div class="max-w-2xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold text-white mb-4">Thanks for supporting ORBIS</h1>

    <p id="state" class="text-zinc-400 mb-4">Generating your license key…</p>

    <pre
      id="key"
      class="rounded-xl p-4 text-sm mb-6 whitespace-pre-wrap break-all"
      style="display: none; background: #18181b; border: 1px solid #27272a; color: #a5b4fc;"
    ></pre>

    <div id="paste" class="mb-10" style="display: none;">
      <h2 class="text-lg font-semibold text-white mb-3">Activate it</h2>
      <ol class="space-y-3">
        {[
          'Copy the key above.',
          'In ORBIS, open Settings → Orb → Unlock.',
          'Paste the key and hit Activate. Customization unlocks instantly.',
        ].map((step, i) => (
          <li class="flex gap-4 items-start">
            <span class="font-mono text-sm w-5 shrink-0 pt-0.5" style="color: #818cf8;">{i + 1}</span>
            <span class="text-zinc-300 text-sm">{step}</span>
          </li>
        ))}
      </ol>
      <p class="text-zinc-500 text-sm mt-4">
        We also emailed the key to you — keep it to re-activate on any machine.
      </p>
    </div>

    <a href="/" class="text-zinc-400 hover:text-zinc-200 transition-colors underline underline-offset-2 text-sm">
      ← Back to orbis.protolabs.studio
    </a>
  </div>

  <script define:vars={{ issuerUrl }}>
    const stateEl = document.getElementById('state');
    const keyEl = document.getElementById('key');
    const pasteEl = document.getElementById('paste');
    const sessionId = new URLSearchParams(location.search).get('session_id');

    const showKey = (token) => {
      keyEl.textContent = token;
      keyEl.style.display = 'block';
      pasteEl.style.display = 'block';
      stateEl.textContent = "Here's your license key:";
    };

    async function poll(attempt) {
      if (!issuerUrl || !sessionId) {
        stateEl.textContent =
          'We couldn’t find your session — check your email for the license key.';
        return;
      }
      try {
        const res = await fetch(
          issuerUrl.replace(/\/$/, '') + '/license?session_id=' + encodeURIComponent(sessionId),
        );
        const data = await res.json();
        if (data && data.token) {
          showKey(data.token);
          return;
        }
      } catch {
        /* transient — keep polling */
      }
      if (attempt < 20) {
        setTimeout(() => poll(attempt + 1), 3000);
      } else {
        stateEl.textContent =
          'This is taking longer than expected — your key will arrive by email shortly.';
      }
    }

    poll(0);
  </script>
</BaseLayout>

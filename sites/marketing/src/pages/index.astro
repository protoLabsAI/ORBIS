---
import BaseLayout from '../layouts/BaseLayout.astro';
import { OrbHero } from '../components/OrbHero';
---

<BaseLayout title="ORBIS — Voice AI Companion">

  <!-- Hero -->
  <section class="min-h-[calc(100vh-3.5rem)] flex flex-col items-center justify-center gap-8 px-6 py-20 text-center">

    <!-- Orb + pills — fixed dimensions so nothing shifts on hydration -->
    <div class="flex flex-col items-center gap-6">

      <!-- Fixed-size orb slot: skeleton shows until R3F paints -->
      <div id="orb-slot" class="relative flex items-center justify-center"
           style="width: 480px; height: 480px; max-width: min(480px, calc(100vw - 3rem)); border-radius: 50%; box-shadow: 0 0 100px rgba(129,140,248,0.3), 0 0 40px rgba(244,114,182,0.15);">


        <!-- Static skeleton visible before hydration -->
        <div id="orb-skeleton"
             class="absolute inset-0 rounded-full flex items-center justify-center transition-opacity duration-700"
             style="background: radial-gradient(circle at 40% 35%, #1e1b2e 0%, #09090b 70%);
                    box-shadow: 0 0 100px rgba(129,140,248,0.25), 0 0 40px rgba(244,114,182,0.12);">
          <div class="orb-skeleton-ring"
               style="width: 55%; height: 55%; border-radius: 50%;
                      border: 1.5px solid rgba(129,140,248,0.25);
                      box-shadow: 0 0 32px rgba(129,140,248,0.12) inset, 0 0 32px rgba(129,140,248,0.12);">
          </div>
        </div>

        <!-- React island mounts here — absolutely positioned so it doesn't affect layout -->
        <div class="absolute inset-0 rounded-full overflow-hidden">
          <OrbHero client:only="react" />
        </div>
      </div>

      <!-- State pills — rendered in Astro, always visible, JS wires up active state -->
      <div class="flex gap-2 flex-wrap justify-center" id="state-pills">
        {(['idle', 'listening', 'thinking', 'speaking'] as const).map((s) => (
          <button
            data-state-pill={s}
            data-active={s === 'idle' ? 'true' : 'false'}
            class="state-pill px-4 py-1.5 rounded-full text-sm font-medium border transition-all duration-200"
          >
            {s.charAt(0).toUpperCase() + s.slice(1)}
          </button>
        ))}
      </div>
    </div>

    <div class="flex flex-col items-center gap-4 max-w-2xl">
      <div class="flex items-center gap-3">
        <span class="text-accent font-mono text-sm uppercase tracking-widest">Voice + Personality for your agents</span>
        <span class="px-2 py-0.5 rounded-full text-[11px] font-mono uppercase tracking-wider text-accent border border-indigo-400/40" style="background: rgba(129,140,248,0.10)">Beta</span>
      </div>

      <h1 class="text-4xl md:text-6xl font-bold leading-[1.1] tracking-tight text-white">
        Give your AI a <span style="color: #818cf8;">voice.</span><br />
        Give it a personality.
      </h1>

      <p class="text-lg text-zinc-400 max-w-xl">
        ORBIS sits between you and your agents — listening, routing, and responding with a presence that feels native to your workflow.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-3 mt-2">
        <a
          href="/download"
          class="px-6 py-3 rounded-lg font-medium text-white transition-colors"
          style="background: #818cf8;"
          onmouseover="this.style.background='#6366f1'"
          onmouseout="this.style.background='#818cf8'"
        >
          Download for Mac
        </a>
        <a
          href="/docs"
          class="px-6 py-3 rounded-lg font-medium text-zinc-300 border border-white/10 hover:border-white/20 transition-colors"
        >
          Read the docs
        </a>
      </div>
      <span class="text-zinc-500 text-sm">macOS 13+ · Apple Silicon · Free public beta</span>
    </div>
  </section>

  <!-- Features strip -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <div class="grid md:grid-cols-3 gap-4">
      {[
        {
          heading: 'Voice-native',
          body: 'Say “Hey Orbis,” speak naturally, even interrupt her mid-sentence. No typing, no window-switching — just talk.',
        },
        {
          heading: 'On-device or cloud',
          body: 'Local speech models by default (Apple MLX) — your conversations stay on your Mac — or bring your own cloud models. Your call.',
        },
        {
          heading: 'Delegates anywhere',
          body: 'Route to any OpenAI-compatible agent, A2A endpoint, or local model. ORBIS orchestrates the right brain for the job.',
        },
      ].map(({ heading, body }) => (
        <div class="border border-white/5 rounded-xl p-6" style="background: rgba(255,255,255,0.02)">
          <h3 class="text-white font-semibold mb-2">{heading}</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">{body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="max-w-5xl mx-auto px-6 py-20 border-t border-white/5">
    <div class="text-center mb-12">
      <span class="text-accent font-mono text-sm uppercase tracking-widest block mb-3">How it works</span>
      <h2 class="text-2xl md:text-3xl font-bold text-white">From wake word to answer in under two seconds.</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8 relative">
      {[
        { n: '1', heading: 'Wake', body: 'Say the wake word. ORBIS opens the pipeline.' },
        { n: '2', heading: 'Speak', body: 'Ask anything. ORBIS routes to the right agent, model, or tool.' },
        { n: '3', heading: 'Done', body: 'Hear the response. No app-switching, no typing.' },
      ].map(({ n, heading, body }) => (
        <div class="flex flex-col items-center text-center gap-3">
          <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-mono font-semibold text-accent border border-indigo-400/30" style="background: rgba(129,140,248,0.08)">
            {n}
          </div>
          <h3 class="text-white font-semibold">{heading}</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">{body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA banner -->
  <section class="border-t border-b border-white/5 py-20" style="background: rgba(255,255,255,0.015)">
    <div class="max-w-5xl mx-auto px-6 flex flex-col items-center gap-4 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white">Give your agents a voice.</h2>
      <a
        href="/download"
        class="px-6 py-3 rounded-lg font-medium text-white transition-colors"
        style="background: #818cf8;"
        onmouseover="this.style.background='#6366f1'"
        onmouseout="this.style.background='#818cf8'"
      >
        Download for Mac
      </a>
      <p class="text-zinc-500 text-sm">macOS 13+ · Apple Silicon · Free public beta</p>
    </div>
  </section>

</BaseLayout>

<style>
  /* State pill base + active states */
  .state-pill {
    border-color: rgba(255,255,255,0.10);
    background: rgba(255,255,255,0.03);
    color: #a1a1aa;
  }
  .state-pill:hover {
    border-color: rgba(255,255,255,0.20);
    color: #d4d4d8;
  }
  .state-pill[data-active="true"] {
    border-color: rgba(129,140,248,0.60);
    background: rgba(129,140,248,0.15);
    color: #a5b4fc;
  }

  /* Skeleton pulse */
  @keyframes orbPulse {
    0%, 100% { opacity: 0.4; transform: scale(0.97); }
    50%       { opacity: 1;   transform: scale(1.03); }
  }
  .orb-skeleton-ring {
    animation: orbPulse 2s ease-in-out infinite;
  }

  /* Responsive orb slot */
  @media (max-width: 640px) {
    #orb-slot { width: 320px !important; height: 320px !important; }
  }
</style>

<script>
  // Wire pill clicks → dispatch CustomEvent consumed by OrbHero React island
  document.querySelectorAll<HTMLButtonElement>('[data-state-pill]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const state = btn.dataset.statePill!;
      // Update active styling immediately (React will echo back via data-active too)
      document.querySelectorAll<HTMLButtonElement>('[data-state-pill]').forEach((b) => {
        b.dataset.active = String(b === btn);
      });
      window.dispatchEvent(new CustomEvent('orbis:voiceState', { detail: { state } }));
    });
  });

  // Fade out the static skeleton once the React canvas fires its ready event
  window.addEventListener('orbis:canvasReady', () => {
    const skeleton = document.getElementById('orb-skeleton');
    if (skeleton) {
      skeleton.style.opacity = '0';
      skeleton.style.pointerEvents = 'none';
    }
  });
</script>

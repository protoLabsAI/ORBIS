---
import BaseLayout from '../layouts/BaseLayout.astro';
import changelog from '../../data/changelog.json';

const latest = changelog[0];
---

<BaseLayout title="Download ORBIS" description="Download ORBIS — the voice-first AI companion for Mac. Free for Apple Silicon and Intel.">
  <div class="max-w-2xl mx-auto px-6 py-24">
    <div class="mb-10">
      <h1 class="text-4xl font-bold text-white mb-3">Download ORBIS</h1>
      <div class="flex items-center gap-3">
        <span class="px-2 py-0.5 rounded text-sm font-mono border border-white/[0.08]" style="background: #18181b; color: #818cf8;">
          {latest.version}
        </span>
        <span class="text-zinc-500 text-sm">{latest.date}</span>
      </div>
    </div>

    <!-- Primary download -->
    <a
      href={latest.dmgUrl}
      class="flex items-center justify-center gap-3 w-full py-4 px-6 rounded-xl font-semibold text-white text-lg mb-10 transition-colors"
      style="background: #818cf8;"
      onmouseover="this.style.background='#6366f1'"
      onmouseout="this.style.background='#818cf8'"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      Download ORBIS {latest.version} (.dmg)
    </a>

    <!-- System requirements -->
    <div class="grid sm:grid-cols-2 gap-4 mb-10">
      {[
        {
          label: 'Minimum',
          items: ['macOS 13 Ventura', '8 GB RAM', 'Intel or Apple Silicon'],
        },
        {
          label: 'Recommended',
          items: ['macOS 14+', 'Apple Silicon M1+', '16 GB RAM (for on-device MLX)'],
        },
      ].map(({ label, items }) => (
        <div class="border border-white/5 rounded-xl p-5" style="background: rgba(255,255,255,0.02)">
          <h3 class="text-white font-semibold mb-3">{label}</h3>
          <ul class="space-y-1.5">
            {items.map((item) => (
              <li class="text-zinc-400 text-sm flex items-start gap-2">
                <span class="text-zinc-600 mt-0.5">—</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Install steps -->
    <div class="mb-10">
      <h2 class="text-lg font-semibold text-white mb-5">Installation</h2>
      <ol class="space-y-4">
        {[
          'Download the .dmg above.',
          'Open it and drag ORBIS to Applications.',
          'Launch ORBIS — allow microphone access when prompted.',
          'The setup wizard walks through the rest.',
        ].map((step, i) => (
          <li class="flex gap-4 items-start">
            <span class="font-mono text-sm text-accent w-5 shrink-0 pt-0.5">{i + 1}</span>
            <span class="text-zinc-300 text-sm">{step}</span>
          </li>
        ))}
      </ol>
    </div>

    <!-- Gatekeeper note -->
    <div class="border-l-2 border-indigo-400/40 pl-4 mb-10">
      <p class="text-zinc-400 text-sm">
        <strong class="text-zinc-200">Intel note:</strong> ORBIS is unsigned on Intel — macOS will show a Gatekeeper warning. Right-click → Open to proceed.
      </p>
    </div>

    <p class="text-zinc-500 text-sm">
      <a href="/changelog" class="text-zinc-400 hover:text-zinc-200 transition-colors underline underline-offset-2">View full release history →</a>
    </p>
  </div>
</BaseLayout>

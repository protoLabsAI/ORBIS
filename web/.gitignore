# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist/*
# Keep the dir itself so `pip install -e .` works from a fresh clone:
# pyproject force-includes web/dist into the wheel, and hatchling
# expects the path to exist before the frontend build populates it.
!dist/.gitkeep
dist-ssr
dev-dist
*.local


+fn verify_uv_archive_sha256(path: &Path, expected: &str) -> Result<()> {
+    let mut file = fs::File::open(path)
+        .with_context(|| format!("unable to open UV archive: {}", path.display()))?;
+    let mut context = digest::Context::new(&digest::SHA256);
+    let mut buffer = [0_u8; 64 * 1024];
+
+    loop {
+        let count = file
+            .read(&mut buffer)
+            .with_context(|| format!("unable to hash UV archive: {}", path.display()))?;
+        if count == 0 {
+            break;
+        }
+        context.update(&buffer[..count]);
+    }
+
+    let actual = context
+        .finish()
+        .as_ref()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect::<String>();
+    if actual != expected {
+        bail!("UV archive checksum mismatch: expected {expected}, got {actual}");
+    }
+    Ok(())
+}

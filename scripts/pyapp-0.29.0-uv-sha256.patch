+#[cfg(test)]
+mod tests {
+    use super::verify_uv_archive_sha256;
+    use std::fs;
+    use tempfile::tempdir;
+
+    const ABC_SHA256: &str = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
+
+    #[test]
+    fn accepts_matching_uv_archive_checksum() {
+        let dir = tempdir().unwrap();
+        let archive = dir.path().join("uv.tar.gz");
+        fs::write(&archive, b"abc").unwrap();
+
+        verify_uv_archive_sha256(&archive, ABC_SHA256).unwrap();
+    }
+
+    #[test]
+    fn rejects_tampered_uv_archive_before_extraction() {
+        let dir = tempdir().unwrap();
+        let archive = dir.path().join("uv.tar.gz");
+        fs::write(&archive, b"tampered").unwrap();
+
+        let error = verify_uv_archive_sha256(&archive, ABC_SHA256).unwrap_err();
+        assert!(error.to_string().contains("UV archive checksum mismatch"));
+    }
+}

+fn set_uv_sha256() {
+    let variable = "PYAPP_UV_SHA256";
+    let checksum = env::var(variable).unwrap_or_default();
+
+    if is_enabled("PYAPP_UV_ENABLED")
+        && (checksum.len() != 64 || !checksum.bytes().all(|byte| byte.is_ascii_hexdigit()))
+    {
+        panic!("{variable} must be exactly 64 hexadecimal characters when PYAPP_UV_ENABLED=1");
+    }
+
+    set_runtime_variable(variable, &checksum.to_ascii_lowercase());
 }
 

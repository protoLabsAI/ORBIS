__pycache__/
*.pyc
.venv/
*.egg-info/
*.crt
*.key
.env
.env.*
!.env.example

# Node
node_modules/

# ORBIS runtime state — per-install user DB + session artifacts.
data/
# Marketing site changelog data is committed (build-time static asset).
!sites/marketing/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# User-edited config (the example is committed, not the real file).
config/orbis.yaml
config/users.yaml

# Per-project Automaker UI state — local config, should not be versioned.
.automaker/

# Build output — `dist/` is the wheel/.tar.gz output from `python -m
# build`; `dist-sdist/` is the staged sidecar source tarball.
dist/
dist-sdist/

# Claude Code agent state — per-machine scratch (scheduled task locks,
# subagent metadata). Should never be versioned.
.claude/

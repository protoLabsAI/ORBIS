{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set — shell sidecar for the ORBIS Python backend, dialog for hardware-unsupported errors.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/orbis",
          "sidecar": true,
          "args": [
            "--host",
            "127.0.0.1",
            "--port",
            "0"
          ]
        }
      ]
    }
  ]
}

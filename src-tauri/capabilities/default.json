{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set — shell sidecar for the ORBIS Python backend, plugin-http for API fetches that bypass WKWebView's broken POST path on macOS arm64 (tauri-apps/tauri#11854, #13166, #13878), dialog for hardware-unsupported errors.",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:default",
    "log:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*/*" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/orbis",
          "sidecar": true,
          "args": [
            "--host",
            "127.0.0.1",
            "--port",
            "0"
          ]
        }
      ]
    }
  ]
}

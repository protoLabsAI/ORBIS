<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Hardened-runtime exceptions WKWebView's WebContent subprocess
         needs to operate under a Developer ID signed app. Without
         allow-jit, WebContent's JavaScript JIT can't allocate
         executable pages, which cascades into the WebRTC media
         pipeline degrading silently — getUserMedia returns a stream
         but the audio decode/transport path runs in interpreted mode
         and Core Audio never wires up to a real input. The matching
         allow-unsigned-executable-memory exception is what actually
         lets the JIT pages execute. disable-library-validation lets
         WebContent load WebKit's helper frameworks (the network
         daemon, the GPU process) which on hardened runtime can fail
         signature checks against our Team ID.
         See https://developer.apple.com/documentation/security/hardened_runtime
         for the full matrix. Safari has these implicitly via Apple's
         system entitlements; Developer-ID apps have to opt in. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>

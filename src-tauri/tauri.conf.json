{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBIS",
  "version": "0.0.0",
  "identifier": "studio.protolabs.orbis",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ORBIS",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Voice-first AI companion",
    "longDescription": "An orb that talks to you, remembers you, and routes the heavy lifting to your configured agents. Voice-first. Single-owner. Runs on your own hardware.",
    "copyright": "Copyright (c) 2026 protoLabs Studio",
    "externalBin": ["binaries/orbis"],
    "resources": {
      "../config/orbis.example.yaml": "config/orbis.example.yaml",
      "../config/persona.md": "config/persona.md",
      "../config/starter_orbs.yaml": "config/starter_orbs.yaml",
      "../config/delegates.yaml": "config/delegates.yaml"
    },
    "macOS": {
      "entitlements": "./entitlements.plist",
      "hardenedRuntime": true,
      "infoPlist": "./Info.plist",
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQTg4QTBCRERFN0E4MDkKUldRSnFPZmRDNHFvK3FMMGdubXlkWGp6bkVmYXFRS29GR1RBVnlpenlUNHh2TUxYWENQdkREUjIK",
      "endpoints": [
        "https://github.com/protoLabsAI/ORBIS/releases/latest/download/latest.json"
      ]
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBIS",
  "version": "0.0.0",
  "identifier": "studio.protolabs.orbis",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ORBIS",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage"],
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Voice-first AI companion",
    "longDescription": "An orb that talks to you, remembers you, and routes the heavy lifting to your configured agents. Voice-first. Single-owner. Runs on your own hardware.",
    "copyright": "Copyright (c) 2026 protoLabs Studio",
    "externalBin": ["binaries/orbis"]
  },
  "plugins": {}
}

# ORBIS local secrets + config.
#
# Copy to `.env` and fill in values. `.env` is gitignored. For deployed
# boxes, prefer injecting these via your secrets manager (Infisical,
# Vault, SOPS, k8s Secret + envFrom, etc.) — the app reads `os.environ`,
# doesn't care where the values came from.

# ─── Ports + paths ──────────────────────────────────────────────────
#PORT=7866                             # 0 = ephemeral (Tauri sidecar default)
#ORBIS_HOST=0.0.0.0                    # Docker: 0.0.0.0. Desktop: 127.0.0.1
#HF_HOME=/mnt/models/huggingface       # Docker compat — ORBIS_CACHE_DIR takes precedence
#MODEL_DIR=/models                     # Legacy alias for HF_HOME
#CONFIG_DIR=config
#DELEGATES_YAML=config/delegates.yaml

# ─── Desktop distribution paths ─────────────────────────────────────
# Tauri bundles set these to OS-standard user dirs at spawn time. The
# Docker path doesn't set them (falls through to HF_HOME + /data mount).
#ORBIS_DB_PATH=/Users/me/Library/Application Support/orbis/orbis.sqlite
#ORBIS_CACHE_DIR=/Users/me/Library/Caches/orbis
# Opt-in to CPU when neither CUDA nor MPS is available. Docker
# compose.cpu.yml sets this; desktop bundles don't (they hard-fail
# with a friendly message pointing at the Docker path).
#ORBIS_ALLOW_CPU=1

# ─── Router LLM (in-pipeline) ───────────────────────────────────────
#START_VLLM=0                          # 1 = spawn local vLLM subprocess
#VLLM_PORT=8100                        # only when START_VLLM=1
#LLM_MODEL=Qwen/Qwen3.5-4B             # only when START_VLLM=1
#LLM_URL=http://localhost:8000/v1
#LLM_SERVED_NAME=local
#LLM_API_KEY=
#LLM_MAX_TOKENS=150
#LLM_TEMPERATURE=0.7
#SYSTEM_PROMPT=

# ─── STT ────────────────────────────────────────────────────────────
#STT_BACKEND=local                     # local | openai | sensevoice
#WHISPER_MODEL=openai/whisper-large-v3-turbo
#STT_URL=https://api.openai.com/v1     # STT_BACKEND=openai
#STT_MODEL=whisper-1
#STT_API_KEY=
# SenseVoice — STT + emotion + audio-event detection in one pass.
# Requires: pip install -e ".[sensevoice]"
# Model cached under HF_HOME / ORBIS_CACHE_DIR (downloaded on first boot).
#SENSEVOICE_MODEL=FunAudioLLM/SenseVoiceSmall   # default
#SENSEVOICE_DEVICE=cuda                          # cuda | cpu | mps (auto if unset)

# ─── TTS ────────────────────────────────────────────────────────────
# ORBIS defaults to kokoro (CPU-friendly, no GPU dependency).
# Alternatives:
#   TTS_BACKEND=openai       → any OpenAI-compatible /v1/audio/speech
#                              endpoint (self-hosted, LocalAI, proxies…)
#   TTS_BACKEND=elevenlabs   → ElevenLabs native WebSocket (pay API,
#                              highest quality)
#   TTS_BACKEND=fish         → Fish S2-Pro sidecar (opt-in; see the
#                              fish-speech docker-compose profile)
#TTS_BACKEND=kokoro                    # kokoro | openai | elevenlabs | fish
#KOKORO_VOICE=af_heart
#KOKORO_LANG=a
# OpenAI-compatible TTS
#TTS_OPENAI_URL=https://api.openai.com/v1
#TTS_OPENAI_MODEL=tts-1
#TTS_OPENAI_VOICE=alloy
#TTS_OPENAI_API_KEY=
#TTS_OPENAI_SAMPLE_RATE=24000
# ElevenLabs native
#ELEVENLABS_API_KEY=
#ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
#ELEVENLABS_MODEL=eleven_turbo_v2_5
#ELEVENLABS_SAMPLE_RATE=24000
# Fish S2-Pro (opt-in; requires the fish-speech sidecar)
#FISH_URL=http://fish-speech:8092
#FISH_REFERENCE_ID=
#FISH_SAMPLE_RATE=44100
#FISH_TIMEOUT=180                      # covers cold-compile warmup

# ─── Entitlement (Stripe — optional, dev is open) ─────────────────
# Absent → customization is open by default (local / dev mode).
# Set all three to enable the paid unlock flow; the webhook endpoint
# at /api/stripe/webhook verifies via STRIPE_WEBHOOK_SECRET.
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_CUSTOMIZATION=price_...
#STRIPE_SUCCESS_URL=http://localhost:7866/?checkout=success
#STRIPE_CANCEL_URL=http://localhost:7866/?checkout=cancel
# Days the local entitlement cache tolerates being offline before
# re-verification is required. Default 7.
#ENTITLEMENT_CACHE_DAYS=7
# How often the background task re-queries Stripe to extend the cache.
#ENTITLEMENT_REFRESH_INTERVAL_HOURS=24

# ─── A2A inbound (other agents call us) ─────────────────────────────
#A2A_AUTH_TOKEN=                       # shared secret they send as X-API-Key
#AGENT_NAME=orbis
#AGENT_VERSION=0.1.0
#A2A_MAX_TURNS=10

# ─── Delegates (referenced from config/delegates.yaml) ──────────────
# These are the env vars typical delegate entries point at.
# Add more as you extend config/delegates.yaml.
AVA_API_KEY=
#AVA_URL=http://ava:3008/a2a
#LITELLM_MASTER_KEY=                   # for a LiteLLM-fronted openai delegate

# ─── Audio handling ─────────────────────────────────────────────────
# Desktop production builds are native-audio only. Tauri sets these
# automatically when it spawns the sidecar; leave them unset outside
# focused transport tests.
#AUDIO_TRANSPORT=native
#
# Unix socket path that the Rust sidecar writes PCM to. Tauri sets this
# automatically (PID-namespaced).
#ORBIS_AUDIO_SOCK=/tmp/orbis-audio-{pid}.sock
# Mac production builds use AVAudioEngine voice-processing input
# (AEC + AGC + noise suppression), which defaults MIC_GAIN to 1.0.
#ORBIS_AUDIO_INPUT_MODE=voice_processing
#
#ECHO_GUARD_MS=300
#HALF_DUPLEX=0
#NOISE_FILTER=off                      # off | rnnoise — needs .[rnnoise]
#SMART_TURN=off                        # off | local — needs .[smart-turn]
# Audio-tags side-channel (mood + [audio] context injection).
# Active when STT_BACKEND=sensevoice. Has no effect with local/openai STT.
#AUDIO_TAGS=on                         # on | off

# ─── Filler verbosity + backchannels ────────────────────────────────
#VERBOSITY=brief                       # silent | brief | narrated | chatty
#BACKCHANNEL_FIRST_SECS=5.0
#BACKCHANNEL_INTERVAL_SECS=6.0

# ─── Delivery-controller edge-case timers ──────────────────────────
#DELIVERY_NEXT_SILENCE_FALLBACK_SECS=10   # drain after N seconds if VAD never sees user-stop (muted mic)
#DELIVERY_WHEN_ASKED_TTL_SECS=600         # drop WHEN_ASKED items after N seconds (10 min default)

# ─── Langfuse tracing ───────────────────────────────────────────────
# When all three are set, every user turn creates a trace spanning
# STT → LLM → tools → TTS. Session = native voice session. Cross-fleet
# propagation via Langfuse-Trace-Id / Langfuse-Session-Id headers.
# See docs/reference/tracing.md. Leave unset to run without tracing.
#LANGFUSE_HOST=http://ava:3000        # internal alias; or use LANGFUSE_BASE_URL
#LANGFUSE_BASE_URL=https://langfuse.proto-labs.ai  # Langfuse SDK default name
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...

# ─── A2A push notifications ────────────────────────────────────────
# When set, outbound delegate_to calls attach a pushNotificationConfig
# pointing at A2A_PUSH_URL so remote agents can post results back here
# via /a2a/push even if the SSE stream dropped. A2A_PUSH_TOKEN is a
# shared secret; our server validates inbound /a2a/push requests have
# a matching Authorization: Bearer or body.token field.
#A2A_PUSH_URL=https://your-tailnet-host.ts.net/a2a/push
#A2A_PUSH_TOKEN=random-secret-here

# ─── Memory (pipecat LLMContextSummarizer) ─────────────────────────
#MEMORY_SUMMARIZE=1
#MEMORY_MAX_CONTEXT_TOKENS=8000
#MEMORY_MAX_MESSAGES=20
#MEMORY_TARGET_CONTEXT_TOKENS=4000

# ─── Tool tunables ──────────────────────────────────────────────────
#TZ=America/New_York
#SLOW_RESEARCH_SECS=20
#FAKE_RESEARCH_SECS=4

# ─── docker-compose overrides (read by compose, not by Python) ──────
# These don't go into the container env; they shape how compose renders
# docker-compose.yml. Include them in .env only if you want compose to
# pick them up.
#NVIDIA_VISIBLE_DEVICES=0
#PROTOVOICE_GPU=0
#FISH_GPU=1
#FISH_REFERENCES_DIR=/mnt/data/fish-references
#FISH_PORT=8092
